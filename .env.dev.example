# Скопировать в .env.dev. Здесь только DEV, рабочий .env не подключается.
# Тестовая копия таблицы: ID задайте через RF_DEV_SPREADSHEET_ID при запуске Compose.
GOOGLE_WORKSHEET_NAME=RACES
# Доступы именно к DEV WordPress; получить у ПМ/Кирилла.
WP_ADMIN_USER=
WP_ADMIN_PASS=
WP_CONSUMER_KEY=
WP_CONSUMER_SECRET=
# Ключи провайдеров потребуются только для реального импорта, не для preview.
OPENAI_API_KEY=
OPENCAGE_API_KEY=
ENABLE_SPAIN=false
# Добавить реальные DEV ID корневых категорий en_parent_id/es_parent_id/pt_parent_id.
CATEGORY_ROOT_MAP_JSON={}
SKIP_IMAGE=true
LOG_FILE=/app/logs/automation.log
